# Server Configuration
SERVER_PORT=8080

# Backend Base URL
# The public URL where this backend is accessed
# Used for generating absolute URLs, email links, etc.
BACKEND_BASE_URL=http://localhost:8080

# Database Configuration
DB_URL=jdbc:postgresql://localhost:55432/insureclaim
DB_USERNAME=insureclaim
DB_PASSWORD=insureclaim
DB_POOL_SIZE=10

# JWT Configuration
JWT_SECRET=insureclaim-development-secret-key-change-me-in-production-0123456789
JWT_ISSUER=insureclaim-portal
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Storage Configuration
STORAGE_DIR=./data/uploads

# Seed Data Configuration
INSURECLAIM_SEED_ENABLED=true
INSURECLAIM_SEED_PASSWORD=

# Chatbot Configuration
CHATBOT_ENABLED=true
CHATBOT_API_KEY=
CHATBOT_BASE_URL=https://api.anthropic.com
CHATBOT_MODEL=claude-sonnet-5
CHATBOT_MAX_TOKENS=700
