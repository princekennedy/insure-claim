# Build-time public URLs - inlined into the client bundle by `next build`.
# Local overrides go in `.env.local` (gitignored); Dokploy/Docker can override
# via the matching NEXT_PUBLIC_* build args (see Dockerfile).

# Backend API base URL
NEXT_PUBLIC_API_URL=http://britam-backend-yolc8j-2c8561-169-58-167-64.sslip.io

# This frontend's public origin (SSR / redirect flows)
NEXT_PUBLIC_FRONTEND_URL=http://britam-frontend-wmq0ha-a84bcd-169-58-167-64.sslip.io

# Storage/MinIO URL - leave empty to serve files through the API
NEXT_PUBLIC_STORAGE_URL=
