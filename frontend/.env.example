# Copy to `.env.local` for local development (gitignored).
# Deployment values live in `.env.production` (committed).

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# This frontend's public origin (SSR / redirect flows)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Storage/MinIO URL - leave empty to serve files through the API
NEXT_PUBLIC_STORAGE_URL=
